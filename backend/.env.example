FARMFLOW_ARTIFACTS_DIR=../artifacts
FARMFLOW_MODELS_DIR=../models
FARMFLOW_QML_DEVICE=lightning.qubit
FARMFLOW_LOG_LEVEL=INFO
FARMFLOW_SIMULATION_SEED=42
FARMFLOW_SIMULATION_TICK_SECONDS=1.0
FARMFLOW_SIMULATION_SPEED=1.0
FARMFLOW_SIMULATION_TELEMETRY_FREQUENCY=1
FARMFLOW_SIMULATION_SOIL_SENSOR_COUNT=2
FARMFLOW_SIMULATION_TEMPERATURE_SENSOR_COUNT=1
FARMFLOW_SIMULATION_HUMIDITY_SENSOR_COUNT=1
FARMFLOW_FEATURE_FLOW_INACTIVITY_TIMEOUT_SECONDS=5.0
FARMFLOW_FEATURE_FLOW_MAX_AGE_SECONDS=30.0
FARMFLOW_FEATURE_EMISSION_INTERVAL_SECONDS=1.0
FARMFLOW_FEATURE_MIN_PACKETS=2
FARMFLOW_FEATURE_HISTORY_LIMIT=500
FARMFLOW_FEATURE_PROVENANCE_LIMIT=64
FARMFLOW_ATTACK_HISTORY_LIMIT=500
FARMFLOW_AUTONOMOUS_DEFENSE_ENABLED=true
FARMFLOW_AUTONOMOUS_DEFENSE_MINIMUM_SEVERITY=high
FARMFLOW_RECOVERY_VERIFICATION_TICKS=2
FARMFLOW_MAX_CONCURRENT_DEFENSE_ACTIONS=4
FARMFLOW_AUTO_RUN_SIMULATION=false
FARMFLOW_RUNTIME_TICK_INTERVAL_SECONDS=1.0
FARMFLOW_DEMO_SEED=1515
FARMFLOW_WEBSOCKET_QUEUE_SIZE=256
FARMFLOW_RUNTIME_RECENT_EVENT_LIMIT=2000
FARMFLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
